API_ID=
API_HASH=
SESSION_PATH=data/tg_session
MAX_LIMIT=30
MAX_TEXT=500
# ENC_KEY va MCP_SECRET ni python setup.py yaratadi.
# Ushbu namunani haqiqiy .env ustidan ko‘chirmang.
DATA_DIR=data
PUBLIC_URL=https://localhost

# Google bilan kirish (ixtiyoriy; uchalasi birga kerak). Haqiqiy qiymatlarni faqat Railway Variables'ga yozing.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# ADMIN_EMAIL=egasi@gmail.com

# MCP uchun bitta URL (OAuth). Ixtiyoriy; yoqilmasa eski maxfiy URLlar avvalgidek ishlaydi.
# MCP_OAUTH=1
# OAUTH_REDIRECTS=https://qoshimcha.app/callback   # ixtiyoriy, vergul bilan (ChatGPT uchun keyin aniqlanadi)

# Instagram (ixtiyoriy). Token saytdagi Instagram bo‘limida kiritiladi, Variables'ga yozilmaydi.
# INSTAGRAM=1
# INSTAGRAM_API_VERSION=v26.0
